{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Static Site (Python)",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "Static Site (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-p",
        "3001",
        "."
      ],
      "port": 3001
    }
  ]
}